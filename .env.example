APP_NAME=USCaseMonitor
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_URL=sqlite:///./uscase.db
APP_TIMEZONE=Asia/Shanghai
POLL_INTERVAL_HOURS=24
POLL_BATCH_SIZE=20
POLL_DELAY_SECONDS=10

# 163 SMTP. Use a newly generated authorization code, not webmail password.
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_AUTH_CODE=
SMTP_FROM_NAME=USCaseMonitor
DEFAULT_NOTIFY_EMAILS=

